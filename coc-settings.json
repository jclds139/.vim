{
	"languageserver": {
		"bash": {
			"command": "npx",
			"args": ["bash-language-server", "start"],
			"filetypes": ["sh", "bash", "PKGBUILD"]
		},
		"systemd-ls": {
			"command": "systemd-lsp",
			"filetypes": ["systemd"]
		}
	},

	"ltex.enabled": [
		"bibtex",
		"context",
		"context.tex",
		"html",
		"latex",
		"tex",
		"latex",
		"markdown",
		"org",
		"restructuredtext",
		"rst",
		"rsweave",
		"python",
		"c",
		"cpp",
		"arduino",
		"shellscript"
	],
	"ltex.dictionary": {
		"en-US": [":${userHome}/.vim/spell/en.utf-8.add"]
	},
	"ltex.languageToolHttpServerUri": "http://localhost:8081/",
	"ltex.completionEnabled": true,
	"ltex.additionalRules.motherTongue": "en-US",
	"texlab.auxDirectory": "build/",
	"texlab.latexFormatter": "tex-fmt",
	"texlab.build.args": ["-interaction=nonstopmode", "-synctex=1", "%f"],
	"inlayHint.maximumLength": 20,
	"[tex][latex]": {
		"coc.preferences.formatterExtension": "coc-texlab"
	},

	"pylsp.disableProgressNotifications": false,
	"pylsp.plugins.ruff.enabled": false,
	"pylsp.plugins.pycodestyle.enabled": false,
	"pylsp.plugins.yapf.enabled": false,
	"pylsp.plugins.mccabe.enabled": false,
	"pylsp.plugins.pyflakes.enabled": false,
	"pylsp.plugins.autopep8.enabled": false,
	"pylsp.plugins.black.enabled": false,
	"pylsp.plugins.rope_completion.eager": true,
	"pylsp.plugins.rope_autoimport.code_actions.enabled": true,
	"pylsp.plugins.ruff.formatEnabled": false,
	"pylsp.signature.formatter": "ruff",
	"pylsp.plugins.jedi_symbols.include_import_symbols": true,
	"ruff.nativeServer": true,
	"ruff.codeAction.fixViolation.enable": true,
	"ruff.client.codeAction.showDocumantaion.enable": true,
	"ruff.organizeImports": true,
	"ruff.configurationPreference": "filesystemFirst",
	"ruff.enableExperimentalFormatter": true,
	"snippets.ultisnips.pythonPrompt": false,
	"pydocstring.formatter": "numpy",
	"[python]": {
		"coc.preferences.formatterExtension": "@yaegassy/coc-ruff"
	},

	"java.home": "/usr/lib/jvm/default/",

	"diagnostic-languageserver.filetypes": {
		"tiddlywiki": ["proselint", "alex-text"],
		"tex": ["proselint", "alex"],
		"latex": ["proselint", "alex"],
		"markdown": ["proselint", "alex"],
		"systemd": ["systemd-analyze"],
		"yaml.gha": ["actionlint"],
	},
	"diagnostic-languageserver.mergeConfig": true,
	"diagnostic-languageserver.formatFiletypes": {
		"restructuredtext": "rst-pandoc",
		"rst": "rst-pandoc",
	},
	"diagnostic-languageserver.formatters": {
		"rst-pandoc": {
			"command": "pandoc",
			"args": ["-f", "rst", "-t", "rst", "-s", "--columns=79"]
		},
	},

	"copilot.enable": false,

	"prettier.useTabs": true,
	"prettier.tabWidth": 4,
	"prettier.withNodeModules": true,
	"prettier.formatterPriority": -5,
	//don't override other formatters when available
	"[json][yaml][html][javascript][typescript][markdown]": {
		"coc.preferences.formatterExtension": "coc-prettier"
	},

	"rpc.showProblems": false,
	"rpc.workspaceElapsedTime": true,
	"rpc.suppressNotifications": false,
}
